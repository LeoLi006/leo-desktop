{
  "manifest_version": 3,
  "name": "Leo Web AI",
  "version": "1.1.1",
  "description": "Fill and send Leo prompts on Gemini, DeepSeek and ChatGPT. No API key, telemetry or background service.",
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
